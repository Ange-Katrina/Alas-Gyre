:load_config
if exist "!CONF_FILE!" (
    for /f "usebackq tokens=1,* delims==" %%A in ("!CONF_FILE!") do (
        if /i "%%A"=="ALAS_ROOT" set "ALAS_ROOT=%%B"
        if /i "%%A"=="GYRE_UPDATE_HOST" set "GYRE_UPDATE_HOST=%%B"
        if /i "%%A"=="GYRE_UPDATE_PORT" set "GYRE_UPDATE_PORT=%%B"
        if /i "%%A"=="GYRE_LOG_MAX_BYTES" set "GYRE_LOG_MAX_BYTES=%%B"
        if /i "%%A"=="GYRE_LOG_BACKUP_COUNT" set "GYRE_LOG_BACKUP_COUNT=%%B"
        if /i "%%A"=="ALAS_WEBUI_PORT" set "ALAS_WEBUI_PORT=%%B"
        if /i "%%A"=="GYRE_LANG" set "GYRE_LANG=%%B"
    )
)
if not defined ALAS_ROOT if exist "!ALAS_ROOT_CACHE!" set /p ALAS_ROOT=<"!ALAS_ROOT_CACHE!"
for /f "delims=0123456789" %%X in ("!GYRE_LOG_MAX_BYTES!") do set "GYRE_LOG_MAX_BYTES=10485760"
for /f "delims=0123456789" %%X in ("!GYRE_LOG_BACKUP_COUNT!") do set "GYRE_LOG_BACKUP_COUNT=3"
if not defined GYRE_LOG_MAX_BYTES set "GYRE_LOG_MAX_BYTES=10485760"
if not defined GYRE_LOG_BACKUP_COUNT set "GYRE_LOG_BACKUP_COUNT=3"
exit /b 0

:detect_language
if defined GYRE_LANG exit /b 0
for /f "usebackq delims=" %%L in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $names=@([Globalization.CultureInfo]::CurrentUICulture.Name,[Globalization.CultureInfo]::CurrentCulture.Name); if ($names -match '^zh') { 'zh' } else { 'en' } } catch { 'en' }" ^<nul 2^>nul`) do set "GYRE_LANG=%%L"
if not defined GYRE_LANG set "GYRE_LANG=en"
exit /b 0

:save_config
powershell -NoProfile -ExecutionPolicy Bypass -Command "$enc=New-Object System.Text.UTF8Encoding($false); $nl=[Environment]::NewLine; $content='ALAS_ROOT='+$env:ALAS_ROOT+$nl+'GYRE_UPDATE_HOST='+$env:GYRE_UPDATE_HOST+$nl+'GYRE_UPDATE_PORT='+$env:GYRE_UPDATE_PORT+$nl+'ALAS_WEBUI_PORT='+$env:ALAS_WEBUI_PORT+$nl+'GYRE_LANG='+$env:GYRE_LANG+$nl+'GYRE_LOG_MAX_BYTES='+$env:GYRE_LOG_MAX_BYTES+$nl+'GYRE_LOG_BACKUP_COUNT='+$env:GYRE_LOG_BACKUP_COUNT+$nl; [System.IO.File]::WriteAllText($env:CONF_FILE,$content,$enc); [System.IO.File]::WriteAllText($env:ALAS_ROOT_CACHE,$env:ALAS_ROOT,$enc)" <nul >nul 2>nul
exit /b !ERRORLEVEL!

:is_alas_root
if "%~1"=="" exit /b 1
if exist "%~1\gui.py" if exist "%~1\module\webui\app.py" exit /b 0
exit /b 1

:get_managed_pid
set "MANAGED_PID="
if exist "!PID_FILE!" set /p MANAGED_PID=<"!PID_FILE!"
exit /b 0

:get_updater_pid
set "UPDATER_PID="
if exist "!UPDATER_PID_FILE!" set /p UPDATER_PID=<"!UPDATER_PID_FILE!"
exit /b 0

:is_pid_running
if "%~1"=="" exit /b 1
tasklist /FI "PID eq %~1" /NH 2>nul | findstr /R /C:"[ ][ ]*%~1[ ][ ]*" >nul
exit /b !ERRORLEVEL!

:updater_token_matches
powershell -NoProfile -ExecutionPolicy Bypass -Command "$port=[int]$env:GYRE_UPDATE_PORT; $token=[string]$env:ALAS_GYRE_API_TOKEN; try { $resp=Invoke-WebRequest -UseBasicParsing -Uri ('http://127.0.0.1:'+$port+'/runtime/info') -Headers @{'X-Alas-Gyre-Token'=$token} -TimeoutSec 2; if ($resp.StatusCode -eq 200) { exit 0 }; exit 1 } catch { if ($_.Exception.Response -and [int]$_.Exception.Response.StatusCode -eq 401) { exit 2 }; exit 1 }" <nul >nul 2>nul
exit /b !ERRORLEVEL!

:get_update_port_pid
set "UPDATER_PORT_PID="
for /f "usebackq delims=" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Get-NetTCPConnection -LocalPort $env:GYRE_UPDATE_PORT -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty OwningProcess } catch { try { $port=[int]$env:GYRE_UPDATE_PORT; $pattern=':'+[string]$port+'\s+.*LISTENING\s+(\d+)\s*$'; $line=netstat -ano -p tcp 2>$null | Select-String -Pattern $pattern | Select-Object -First 1; if ($line) { [regex]::Match($line.Line,'(\d+)\s*$').Groups[1].Value } } catch {} }" ^<nul 2^>nul`) do set "UPDATER_PORT_PID=%%P"
exit /b 0

:is_runtime_updater_pid
set "CHECK_PID=%~1"
if not defined CHECK_PID exit /b 1
powershell -NoProfile -ExecutionPolicy Bypass -Command "$check=[int]$env:CHECK_PID; try { $p=Get-CimInstance Win32_Process -Filter ('ProcessId='+$check) -ErrorAction SilentlyContinue; if (-not $p) { $p=Get-WmiObject Win32_Process -Filter ('ProcessId='+$check) -ErrorAction SilentlyContinue }; $cmd=[string]$p.CommandLine; if ($cmd -like '*gyre_runtime_updater.py*') { exit 0 }; exit 1 } catch { exit 1 }" <nul >nul 2>nul
exit /b !ERRORLEVEL!

:adopt_or_report_updater_port
call :get_update_port_pid
if not defined UPDATER_PORT_PID exit /b 1
call :is_runtime_updater_pid "!UPDATER_PORT_PID!"
if not errorlevel 1 (
    > "!UPDATER_PID_FILE!" echo(!UPDATER_PORT_PID!
    call :updater_token_matches
    if not errorlevel 1 exit /b 0
    echo([WARN] Existing runtime updater uses an old token; restarting it.
    call :stop_updater
    exit /b 1
)
echo([WARN] Runtime update port !GYRE_UPDATE_PORT! is already in use by pid=!UPDATER_PORT_PID!.
echo([WARN] Refusing to start another updater. Change GYRE_UPDATE_PORT in .gyre_runtime.conf if needed.
exit /b 2

:prepare_status
set "TXT_STOPPED=STOPPED"
set "TXT_RUNNING=RUNNING"
set "TXT_NOT_CONFIGURED=not configured"
if /i "!GYRE_LANG!"=="en" (
    set "TXT_STOPPED=STOPPED"
    set "TXT_RUNNING=RUNNING"
    set "TXT_NOT_CONFIGURED=not configured"
)
set "ALAS_STATE=!TXT_STOPPED!"
set "UPDATER_STATE=!TXT_STOPPED!"
if defined ALAS_ROOT (
    set "ALAS_ROOT_DISPLAY=!ALAS_ROOT!"
) else (
    set "ALAS_ROOT_DISPLAY=!TXT_NOT_CONFIGURED!"
)
call :get_managed_pid
if defined MANAGED_PID (
    call :is_pid_running "!MANAGED_PID!"
    if errorlevel 1 (
        del "!PID_FILE!" >nul 2>nul
        set "MANAGED_PID="
    ) else (
        set "ALAS_STATE=!TXT_RUNNING! pid=!MANAGED_PID!"
    )
)
call :get_updater_pid
if defined UPDATER_PID (
    call :is_pid_running "!UPDATER_PID!"
    if errorlevel 1 (
        del "!UPDATER_PID_FILE!" >nul 2>nul
        set "UPDATER_PID="
    ) else (
        set "UPDATER_STATE=!TXT_RUNNING! pid=!UPDATER_PID!"
    )
)
exit /b 0

:show_status
call :prepare_status
if /i "!GYRE_LANG!"=="en" goto :show_status_en
echo(
echo([Status]
echo(Managed ALAS : !ALAS_STATE!
echo(Runtime API  : !UPDATER_STATE!
echo(ALAS root    : !ALAS_ROOT_DISPLAY!
echo(Runtime dir  : !GYRE_RUNTIME!
echo(Overlay dir  : !ALAS_GYRE_OVERLAY!
echo(Update port  : !GYRE_UPDATE_HOST!:!GYRE_UPDATE_PORT!
echo(Remote update: LAN access enabled by default. Do not expose this port to the public Internet.
echo(
exit /b 0

