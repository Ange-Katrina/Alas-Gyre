echo(Log          : !UPDATER_LOG_FILE!
echo(Script       : !UPDATER_SCRIPT!
echo(
if exist "!UPDATER_LOG_FILE!" (
    echo(Last updater log lines:
    powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Get-Content -LiteralPath $env:UPDATER_LOG_FILE -Tail 30 } catch {}" <nul
)
exit /b 0

