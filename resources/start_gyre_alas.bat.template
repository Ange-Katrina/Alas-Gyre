:print_utf8_b64
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b='%~1'; $fallback='%~2'; try { [Console]::OutputEncoding=[System.Text.Encoding]::UTF8; [Console]::WriteLine([System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($b))) } catch { [Console]::WriteLine($fallback); exit 1 }" <nul 2>nul
if errorlevel 1 echo(%~2
exit /b 0

:find_python
set "GYRE_PYTHON="
if defined ALAS_ROOT (
    if exist "!ALAS_ROOT!\toolkit\python.exe" (
        set "GYRE_PYTHON=!ALAS_ROOT!\toolkit\python.exe"
        exit /b 0
    )
    if exist "!ALAS_ROOT!\.pixi\envs\default\python.exe" (
        set "GYRE_PYTHON=!ALAS_ROOT!\.pixi\envs\default\python.exe"
        exit /b 0
    )
    if exist "!ALAS_ROOT!\.venv\Scripts\python.exe" (
        set "GYRE_PYTHON=!ALAS_ROOT!\.venv\Scripts\python.exe"
        exit /b 0
    )
    if exist "!ALAS_ROOT!\venv\Scripts\python.exe" (
        set "GYRE_PYTHON=!ALAS_ROOT!\venv\Scripts\python.exe"
        exit /b 0
    )
)
where python >nul 2>nul
if not errorlevel 1 (
    set "GYRE_PYTHON=python"
    exit /b 0
)
where py >nul 2>nul
if not errorlevel 1 (
    set "GYRE_PYTHON=py"
    exit /b 0
)
exit /b 1

:rotate_log
set "ROTATE_LOG_PATH=%~1"
if not defined ROTATE_LOG_PATH exit /b 0
powershell -NoProfile -ExecutionPolicy Bypass -Command "$path=[string]$env:ROTATE_LOG_PATH; $max=[long]10485760; $keep=[int]3; [long]::TryParse([string]$env:GYRE_LOG_MAX_BYTES,[ref]$max) | Out-Null; [int]::TryParse([string]$env:GYRE_LOG_BACKUP_COUNT,[ref]$keep) | Out-Null; if ($max -le 0 -or -not (Test-Path -LiteralPath $path -PathType Leaf)) { exit 0 }; $item=Get-Item -LiteralPath $path -ErrorAction SilentlyContinue; if (-not $item -or $item.Length -lt $max) { exit 0 }; if ($keep -le 0) { Clear-Content -LiteralPath $path -ErrorAction SilentlyContinue; exit 0 }; for ($i=$keep; $i -ge 2; $i--) { $src=$path+'.'+($i-1); $dst=$path+'.'+$i; if (Test-Path -LiteralPath $src) { Move-Item -LiteralPath $src -Destination $dst -Force -ErrorAction SilentlyContinue } }; Move-Item -LiteralPath $path -Destination ($path+'.1') -Force -ErrorAction SilentlyContinue; [System.IO.File]::WriteAllBytes($path, [byte[]]@())" <nul >nul 2>nul
set "ROTATE_LOG_PATH="
exit /b 0

:start_cmd_hidden
set "GYRE_CMD_PATH=%~1"
set "GYRE_LOG_PATH=%~2"
set "GYRE_PID_PATH=%~3"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$q=[char]34; $cmdLine=$q+$env:GYRE_CMD_PATH+$q; $p=Start-Process -FilePath $env:ComSpec -ArgumentList @('/d','/c',$cmdLine) -WindowStyle Hidden -PassThru; Set-Content -LiteralPath $env:GYRE_PID_PATH -Value $p.Id" <nul >nul 2>nul
set "START_RESULT=!ERRORLEVEL!"
set "GYRE_CMD_PATH="
set "GYRE_LOG_PATH="
set "GYRE_PID_PATH="
exit /b !START_RESULT!

:start_updater
call :get_updater_pid
if defined UPDATER_PID (
    call :is_pid_running "!UPDATER_PID!"
    if not errorlevel 1 (
        call :updater_token_matches
        if not errorlevel 1 exit /b 0
        echo([WARN] Runtime updater token does not match current launcher; restarting it.
        call :stop_updater
    )
    del "!UPDATER_PID_FILE!" >nul 2>nul
)
call :adopt_or_report_updater_port
if not errorlevel 1 exit /b 0
if errorlevel 2 exit /b 1
if not exist "!UPDATER_SCRIPT!" (
    echo([WARN] Missing runtime updater script: !UPDATER_SCRIPT!
    exit /b 1
)
call :find_python
if errorlevel 1 (
    echo([WARN] Python was not found. Runtime updater was not started.
    exit /b 1
)
call :rotate_log "!UPDATER_LOG_FILE!"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$q=[char]34; $lines=@(); $lines += '@echo off'; $lines += ('set '+$q+'ALAS_GYRE_API_TOKEN='+$env:ALAS_GYRE_API_TOKEN+$q); $lines += ('set '+$q+'GYRE_UPDATE_HOST='+$env:GYRE_UPDATE_HOST+$q); $lines += ('set '+$q+'GYRE_UPDATE_PORT='+$env:GYRE_UPDATE_PORT+$q); $lines += ('set '+$q+'GYRE_LOG_MAX_BYTES='+$env:GYRE_LOG_MAX_BYTES+$q); $lines += ('set '+$q+'GYRE_LOG_BACKUP_COUNT='+$env:GYRE_LOG_BACKUP_COUNT+$q); $lines += ('cd /d '+$q+$env:GYRE_RUNTIME+$q); $lines += ($q+$env:GYRE_PYTHON+$q+' '+$q+$env:UPDATER_SCRIPT+$q+' --runtime '+$q+$env:GYRE_RUNTIME+$q+' --host '+$q+$env:GYRE_UPDATE_HOST+$q+' --port '+$q+$env:GYRE_UPDATE_PORT+$q+' >> '+$q+$env:UPDATER_LOG_FILE+$q+' 2>&1'); [System.IO.File]::WriteAllLines($env:UPDATER_RUNNER,[string[]]$lines,[System.Text.Encoding]::ASCII)" <nul >nul 2>nul
if errorlevel 1 (
    echo([WARN] Failed to write updater runner: !UPDATER_RUNNER!
    exit /b 1
)
call :start_cmd_hidden "!UPDATER_RUNNER!" "!UPDATER_LOG_FILE!" "!UPDATER_PID_FILE!"
if errorlevel 1 (
    echo([WARN] Runtime updater failed to start. Check PowerShell policy or log.
    exit /b 1
)
timeout /t 1 /nobreak >nul 2>nul
call :get_updater_pid
if defined UPDATER_PID (
    call :is_pid_running "!UPDATER_PID!"
    if not errorlevel 1 (
        echo([Alas-Gyre] Runtime updater: !GYRE_UPDATE_HOST!:!GYRE_UPDATE_PORT! pid=!UPDATER_PID!
        exit /b 0
    )
)
echo([WARN] Runtime updater exited immediately. Check !UPDATER_LOG_FILE!
exit /b 1

:stop_updater
call :get_updater_pid
if not defined UPDATER_PID (
    echo(Runtime updater is not running.
    exit /b 0
)
call :is_pid_running "!UPDATER_PID!"
if errorlevel 1 (
    del "!UPDATER_PID_FILE!" >nul 2>nul
    echo(Runtime updater PID is stale and has been cleaned.
    exit /b 0
)
taskkill /PID !UPDATER_PID! /T /F >nul 2>nul
del "!UPDATER_PID_FILE!" >nul 2>nul
echo(Runtime updater stopped.
exit /b 0

:restart_updater
call :stop_updater
call :start_updater
exit /b !ERRORLEVEL!

:get_alas_webui_port
if defined ALAS_WEBUI_PORT for /f "delims=0123456789" %%X in ("!ALAS_WEBUI_PORT!") do set "ALAS_WEBUI_PORT="
if defined ALAS_WEBUI_PORT exit /b 0
set "ALAS_WEBUI_PORT=22267"
if not defined ALAS_ROOT exit /b 0
if not exist "!ALAS_ROOT!\config\deploy.yaml" exit /b 0
for /f "usebackq delims=" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "$path=Join-Path $env:ALAS_ROOT 'config\deploy.yaml'; try { $m=Select-String -LiteralPath $path -Pattern '^\s*WebuiPort:\s*(\d+)' | Select-Object -First 1; if ($m) { $m.Matches[0].Groups[1].Value } } catch {}" ^<nul 2^>nul`) do set "ALAS_WEBUI_PORT=%%P"
exit /b 0

:get_port_pid
set "PORT_PID="
call :get_alas_webui_port
for /f "usebackq delims=" %%P in (`powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Get-NetTCPConnection -LocalPort $env:ALAS_WEBUI_PORT -State Listen -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty OwningProcess } catch { try { $port=[int]$env:ALAS_WEBUI_PORT; $pattern=':'+[string]$port+'\s+.*LISTENING\s+(\d+)\s*$'; $line=netstat -ano -p tcp 2>$null | Select-String -Pattern $pattern | Select-Object -First 1; if ($line) { [regex]::Match($line.Line,'(\d+)\s*$').Groups[1].Value } } catch {} }" ^<nul 2^>nul`) do set "PORT_PID=%%P"
exit /b 0

:is_safe_port_pid
set "CHECK_PID=%~1"
if not defined CHECK_PID exit /b 1
call :get_managed_pid
if defined MANAGED_PID if "!CHECK_PID!"=="!MANAGED_PID!" exit /b 0
powershell -NoProfile -ExecutionPolicy Bypass -Command "$check=[int]$env:CHECK_PID; $root=[string]$env:ALAS_ROOT; try { $p=Get-CimInstance Win32_Process -Filter ('ProcessId='+$check) -ErrorAction SilentlyContinue; if (-not $p) { $p=Get-WmiObject Win32_Process -Filter ('ProcessId='+$check) -ErrorAction SilentlyContinue }; $cmd=[string]$p.CommandLine; if ($root -and $cmd -and $cmd.IndexOf($root,[StringComparison]::OrdinalIgnoreCase) -ge 0) { exit 0 }; if ($cmd -like '*gui.py*' -and $cmd -like '*AzurLaneAutoScript*') { exit 0 }; exit 1 } catch { exit 1 }" <nul >nul 2>nul
exit /b !ERRORLEVEL!

:ensure_alas_port_free
call :get_alas_webui_port
call :get_port_pid
if not defined PORT_PID exit /b 0
call :is_safe_port_pid "!PORT_PID!"
if errorlevel 1 (
    echo([Alas-Gyre] ALAS WebUI port !ALAS_WEBUI_PORT! is already in use by pid=!PORT_PID!.
    echo([Alas-Gyre] Refusing to kill an unrelated process automatically.
    echo([Alas-Gyre] Stop that process manually, or change ALAS_WEBUI_PORT in .gyre_runtime.conf.
    exit /b 1
)
echo([Alas-Gyre] Stopping process using ALAS WebUI port !ALAS_WEBUI_PORT!: pid=!PORT_PID!
taskkill /PID !PORT_PID! /T /F >nul 2>nul
timeout /t 1 /nobreak >nul 2>nul
call :get_port_pid
if defined PORT_PID (
    echo([Alas-Gyre] ALAS WebUI port !ALAS_WEBUI_PORT! is still in use.
    exit /b 1
)
exit /b 0

:run_alas_core
call :resolve_alas_root
if errorlevel 1 exit /b 1
call :ensure_alas_port_free
if errorlevel 1 exit /b 1
call :start_updater
set "ALAS_ROOT=!ALAS_ROOT!"
set "ALAS_GYRE_OVERLAY=!ALAS_GYRE_OVERLAY!"
set "ALAS_GYRE_API_TOKEN=!ALAS_GYRE_API_TOKEN!"
if defined PYTHONPATH (
    set "PYTHONPATH=!ALAS_GYRE_OVERLAY!;!PYTHONPATH!"
) else (
    set "PYTHONPATH=!ALAS_GYRE_OVERLAY!"
)
cd /d "!ALAS_ROOT!"
echo([Alas-Gyre] ALAS root: !ALAS_ROOT!
echo([Alas-Gyre] Overlay : !ALAS_GYRE_OVERLAY!
echo([Alas-Gyre] Starting ALAS...
if exist "!ALAS_ROOT!\toolkit\python.exe" (
    "!ALAS_ROOT!\toolkit\python.exe" gui.py
) else if exist "!ALAS_ROOT!\.pixi\envs\default\python.exe" (
    "!ALAS_ROOT!\.pixi\envs\default\python.exe" gui.py
) else if exist "!ALAS_ROOT!\.venv\Scripts\python.exe" (
    "!ALAS_ROOT!\.venv\Scripts\python.exe" gui.py
) else if exist "!ALAS_ROOT!\venv\Scripts\python.exe" (
    "!ALAS_ROOT!\venv\Scripts\python.exe" gui.py
) else if exist "!ALAS_ROOT!\run_alas.bat" (
    call "!ALAS_ROOT!\run_alas.bat"
) else (
    python gui.py
)
set "ALAS_EXIT_CODE=!ERRORLEVEL!"
cd /d "!GYRE_RUNTIME!" >nul 2>nul
exit /b !ALAS_EXIT_CODE!

:start_foreground
call :run_alas_core
set "EXIT_CODE=!ERRORLEVEL!"
echo(
echo([Alas-Gyre] ALAS exited. exit_code=!EXIT_CODE!
echo(If this was unexpected, check emulator/device config and the log above.
pause
exit /b 0

:start_background
call :prepare_status
if defined MANAGED_PID (
    echo(Managed ALAS is already running: pid=!MANAGED_PID!
    exit /b 0
)
call :resolve_alas_root
if errorlevel 1 exit /b 1
call :ensure_alas_port_free
if errorlevel 1 exit /b 1
call :rotate_log "!LOG_FILE!"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$q=[char]34; $cmd='call '+$q+$env:SCRIPT_PATH+$q+' __gyre_service_run >> '+$q+$env:LOG_FILE+$q+' 2>&1'; $lines=@('@echo off',$cmd); Set-Content -LiteralPath $env:ALAS_RUNNER -Value $lines -Encoding ASCII" <nul >nul 2>nul
if errorlevel 1 (
    echo(Failed to write ALAS runner: !ALAS_RUNNER!
    exit /b 1
)
call :start_cmd_hidden "!ALAS_RUNNER!" "!LOG_FILE!" "!PID_FILE!"
if errorlevel 1 (
    echo(Failed to start ALAS in background. PowerShell may be blocked by policy.
    exit /b 1
)
timeout /t 2 /nobreak >nul 2>nul
call :get_managed_pid
if defined MANAGED_PID (
    call :is_pid_running "!MANAGED_PID!"
    if not errorlevel 1 (
        echo(ALAS started in background: pid=!MANAGED_PID!
        echo(Log: !LOG_FILE!
        exit /b 0
    )
)
echo(ALAS exited shortly after background start. Check log:
echo(!LOG_FILE!
exit /b 1

:stop_managed
call :get_managed_pid
if not defined MANAGED_PID (
    echo(Managed ALAS is not running.
    exit /b 0
)
call :is_pid_running "!MANAGED_PID!"
if errorlevel 1 (
    del "!PID_FILE!" >nul 2>nul
    echo(ALAS PID is stale and has been cleaned.
    exit /b 0
)
echo(Stopping ALAS pid=!MANAGED_PID! ...
taskkill /PID !MANAGED_PID! /T /F >nul 2>nul
del "!PID_FILE!" >nul 2>nul
echo(ALAS stopped.
exit /b 0

:restart_managed
call :stop_managed
call :start_background
exit /b !ERRORLEVEL!
