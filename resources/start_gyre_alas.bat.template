@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 <nul >nul 2>nul

set "GYRE_RUNTIME=%~dp0"
for %%I in ("!GYRE_RUNTIME!.") do set "GYRE_RUNTIME=%%~fI"
set "SCRIPT_PATH=!GYRE_RUNTIME!\start_gyre_alas.bat"
set "CONF_FILE=!GYRE_RUNTIME!\.gyre_runtime.conf"
set "ALAS_ROOT_CACHE=!GYRE_RUNTIME!\.gyre_alas_root"
set "PID_FILE=!GYRE_RUNTIME!\.gyre_alas.pid"
set "LOG_FILE=!GYRE_RUNTIME!\.gyre_alas.log"
set "ALAS_RUNNER=!GYRE_RUNTIME!\.gyre_run_alas.cmd"
set "UPDATER_SCRIPT=!GYRE_RUNTIME!\gyre_runtime_updater.py"
set "UPDATER_PID_FILE=!GYRE_RUNTIME!\.gyre_updater.pid"
set "UPDATER_LOG_FILE=!GYRE_RUNTIME!\.gyre_updater.log"
set "UPDATER_RUNNER=!GYRE_RUNTIME!\.gyre_run_updater.cmd"
set "CAND_FILE=!TEMP!\gyre_alas_candidates_%RANDOM%_%RANDOM%.txt"
set "ALAS_GYRE_OVERLAY=!GYRE_RUNTIME!\overlay"
set "ALAS_GYRE_API_TOKEN=__API_TOKEN__"
set "GYRE_UPDATE_HOST=0.0.0.0"
set "GYRE_UPDATE_PORT=22268"
set "GYRE_LOG_MAX_BYTES=10485760"
set "GYRE_LOG_BACKUP_COUNT=3"
set "ALAS_WEBUI_PORT="
set "GYRE_LANG="

call :load_config
call :detect_language

if /i "%~1"=="__gyre_service_run" (
    shift
    call :run_alas_core
    exit /b !ERRORLEVEL!
)

if /i "%~1"=="--background" (
    call :start_background
    exit /b !ERRORLEVEL!
)
if /i "%~1"=="--stop" (
    call :stop_managed
    exit /b !ERRORLEVEL!
)
if /i "%~1"=="--status" (
    call :show_status
    exit /b !ERRORLEVEL!
)
if /i "%~1"=="--restart-updater" (
    call :restart_updater
    exit /b !ERRORLEVEL!
)

rem Keep Runtime API available by default once the launcher is opened.
rem This lets the desktop client update gyre_runtime later without another
rem manual visit to this menu. Failures are non-blocking and still visible
rem from the menu/status/log.
call :start_updater >nul 2>nul

