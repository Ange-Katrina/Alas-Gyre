:add_candidate
set "CAND=%~1"
if not defined CAND exit /b 0
for %%I in ("!CAND!") do set "CAND=%%~fI"
call :is_alas_root "!CAND!"
if errorlevel 1 exit /b 0
if exist "!CAND_FILE!" (
    findstr /I /X /C:"!CAND!" "!CAND_FILE!" >nul 2>nul && exit /b 0
)
>> "!CAND_FILE!" echo(!CAND!
exit /b 0

:find_candidates
if exist "!CAND_FILE!" del "!CAND_FILE!" >nul 2>nul
call :add_candidate "!ALAS_ROOT!"
call :add_candidate "!GYRE_RUNTIME!"
call :add_candidate "!GYRE_RUNTIME!\.."
call :add_candidate "!GYRE_RUNTIME!\..\AzurLaneAutoScript"
call :add_candidate "!GYRE_RUNTIME!\..\AlasApp\AzurLaneAutoScript"
call :add_candidate "!USERPROFILE!\AzurLaneAutoScript"
call :add_candidate "!USERPROFILE!\Desktop\AzurLaneAutoScript"
call :add_candidate "!USERPROFILE!\Desktop\UI2\AlasApp_0.4.10_fullcn\AzurLaneAutoScript"
for %%D in (C D E F G H) do (
    call :add_candidate "%%D:\AzurLaneAutoScript"
    call :add_candidate "%%D:\AlasApp\AzurLaneAutoScript"
)
exit /b 0

:auto_resolve_alas_root
if defined ALAS_ROOT (
    call :is_alas_root "!ALAS_ROOT!"
    if not errorlevel 1 (
        for %%I in ("!ALAS_ROOT!") do set "ALAS_ROOT=%%~fI"
        call :save_config
        exit /b 0
    )
    set "ALAS_ROOT="
)
call :find_candidates
for /f "usebackq delims=" %%P in ("!CAND_FILE!") do (
    set "ALAS_ROOT=%%P"
    call :save_config
    del "!CAND_FILE!" >nul 2>nul
    exit /b 0
)
del "!CAND_FILE!" >nul 2>nul
exit /b 1

:resolve_alas_root
call :auto_resolve_alas_root
if not errorlevel 1 exit /b 0
echo(
if /i "!GYRE_LANG!"=="en" (
    echo([Alas-Gyre] ALAS root was not found automatically.
    echo(Enter the directory containing gui.py and module\webui\app.py.
    echo(Press Enter to cancel.
) else call :zh_resolve_help
echo(
set "ALAS_ROOT_INPUT="
set "ALAS_ROOT_PROMPT=ALAS root> "
if /i "!GYRE_LANG!"=="zh" set "ALAS_ROOT_PROMPT=ALAS root> "
set /p ALAS_ROOT_INPUT=!ALAS_ROOT_PROMPT!
if not defined ALAS_ROOT_INPUT exit /b 1
for %%I in ("!ALAS_ROOT_INPUT!") do set "ALAS_ROOT=%%~fI"
call :is_alas_root "!ALAS_ROOT!"
if errorlevel 1 (
    if /i "!GYRE_LANG!"=="en" (
        echo(Invalid ALAS root: !ALAS_ROOT!
    ) else call :zh_invalid_alas_root "!ALAS_ROOT!"
    set "ALAS_ROOT="
    exit /b 1
)
call :save_config
if /i "!GYRE_LANG!"=="en" (
    echo([Alas-Gyre] ALAS root: !ALAS_ROOT!
) else call :zh_alas_root "!ALAS_ROOT!"
exit /b 0
:select_alas_root
call :prepare_status
if defined MANAGED_PID (
    if /i "!GYRE_LANG!"=="en" (
        echo(Managed ALAS is running. Stop it before changing ALAS root.
    ) else call :zh_managed_running_change_root
    exit /b 1
)
echo(
if /i "!GYRE_LANG!"=="en" (
    echo([ALAS root selection]
) else call :zh_select_title
call :find_candidates
set /a CAND_COUNT=0
if exist "!CAND_FILE!" (
    for /f "usebackq delims=" %%P in ("!CAND_FILE!") do (
        set /a CAND_COUNT+=1
        set "CAND_!CAND_COUNT!=%%P"
        echo(  !CAND_COUNT!^) %%P
    )
)
if !CAND_COUNT! EQU 0 (
    if /i "!GYRE_LANG!"=="en" (
        echo(  No candidate found.
    ) else call :zh_no_candidate
)
echo(
if /i "!GYRE_LANG!"=="en" (
    echo(Enter a number from the list, or paste an ALAS root path.
    echo(Press Enter to cancel.
) else call :zh_select_help
set "PICK="
set "PICK_PROMPT=ALAS root> "
if /i "!GYRE_LANG!"=="zh" set "PICK_PROMPT=ALAS root> "
set /p PICK=!PICK_PROMPT!
if not defined PICK (
    del "!CAND_FILE!" >nul 2>nul
    exit /b 1
)
echo(!PICK!| findstr /R "^[0-9][0-9]*$" >nul
if not errorlevel 1 (
    call set "ALAS_ROOT=%%CAND_!PICK!%%"
) else (
    for %%I in ("!PICK!") do set "ALAS_ROOT=%%~fI"
)
del "!CAND_FILE!" >nul 2>nul
call :is_alas_root "!ALAS_ROOT!"
if errorlevel 1 (
    if /i "!GYRE_LANG!"=="en" (
        echo(Invalid ALAS root: !ALAS_ROOT!
    ) else call :zh_invalid_alas_root "!ALAS_ROOT!"
    set "ALAS_ROOT="
    exit /b 1
)
call :save_config
if /i "!GYRE_LANG!"=="en" (
    echo([Alas-Gyre] ALAS root saved: !ALAS_ROOT!
) else call :zh_alas_root_saved "!ALAS_ROOT!"
exit /b 0

