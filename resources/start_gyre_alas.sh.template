detect_alas_webui_port() {
    if [ -n "${ALAS_WEBUI_PORT:-}" ]; then
        case "$ALAS_WEBUI_PORT" in
            *[!0-9]*|'') ;;
            *) printf '%s\n' "$ALAS_WEBUI_PORT"; return 0 ;;
        esac
    fi
    if [ -n "${ALAS_ROOT:-}" ]; then
        for f in "$ALAS_ROOT/config/deploy.yaml" "$ALAS_ROOT/config/deploy.template.yaml"; do
            [ -f "$f" ] || continue
            port="$(sed -n 's/^[[:space:]]*WebuiPort:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$f" 2>/dev/null | sed -n '1p')"
            case "$port" in
                *[!0-9]*|'') ;;
                *) printf '%s\n' "$port"; return 0 ;;
            esac
        done
    fi
    printf '22267\n'
}

port_listener_pids() {
    port="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" {print}' | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p'
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltnp 2>/dev/null | awk -v p=":$port" '$4 ~ p"$" {print $7}' | sed -n 's#^\([0-9][0-9]*\)/.*#\1#p'
    elif command -v lsof >/dev/null 2>&1; then
        lsof -tiTCP:"$port" -sTCP:LISTEN 2>/dev/null || true
    elif command -v fuser >/dev/null 2>&1; then
        fuser -n tcp "$port" 2>/dev/null | tr ' ' '\n' | sed -n 's/[^0-9]//gp'
    fi | sort -u
}

pid_cmdline() {
    pid="$1"
    if [ -r "/proc/$pid/cmdline" ]; then
        tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true
    fi
}

pid_cwd() {
    pid="$1"
    if [ -e "/proc/$pid/cwd" ] && command -v readlink >/dev/null 2>&1; then
        readlink "/proc/$pid/cwd" 2>/dev/null || true
    fi
}

is_safe_alas_port_pid() {
    pid="$1"
    managed="$(get_pid 2>/dev/null || true)"
    [ -n "$managed" ] && [ "$pid" = "$managed" ] && return 0
    cmd="$(pid_cmdline "$pid")"
    cwd="$(pid_cwd "$pid")"
    root="${ALAS_ROOT:-}"
    if [ -n "$root" ]; then
        case " $cmd $cwd " in
            *"$root"*) return 0 ;;
        esac
    fi
    case "$cmd" in
        *gui.py*AzurLaneAutoScript*|*AzurLaneAutoScript*gui.py*) return 0 ;;
    esac
    return 1
}

stop_port_pid() {
    pid="$1"
    reason="$2"
    echo "[Alas-Gyre] Stopping process using $reason. pid=$pid"
    kill "$pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 8 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    echo "[Alas-Gyre] Process pid=$pid did not exit; sending KILL."
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
}

ensure_alas_port_free() {
    port="$(detect_alas_webui_port)"
    ALAS_WEBUI_PORT="$port"
    pids="$(port_listener_pids "$port" 2>/dev/null || true)"
    [ -n "$pids" ] || return 0
    for pid in $pids; do
        [ -n "$pid" ] || continue
        if is_safe_alas_port_pid "$pid"; then
            stop_port_pid "$pid" "ALAS WebUI port $port"
        else
            cmd="$(pid_cmdline "$pid")"
            echo "[Alas-Gyre] ALAS WebUI port $port is already in use by pid=$pid." >&2
            [ -n "$cmd" ] && echo "[Alas-Gyre] Command: $cmd" >&2
            echo "[Alas-Gyre] Refusing to kill an unrelated process automatically." >&2
            echo "[Alas-Gyre] Stop that process manually, or set ALAS_WEBUI_PORT to another port." >&2
            return 1
        fi
    done
    sleep 1
    if [ -n "$(port_listener_pids "$port" 2>/dev/null || true)" ]; then
        echo "[Alas-Gyre] ALAS WebUI port $port is still in use after cleanup." >&2
        return 1
    fi
    return 0
}

prepare_overlay_env() {
    export ALAS_ROOT ALAS_GYRE_OVERLAY ALAS_GYRE_API_TOKEN
    if [ "${PYTHONPATH:-}" ]; then
        export PYTHONPATH="$ALAS_GYRE_OVERLAY:$PYTHONPATH"
    else
        export PYTHONPATH="$ALAS_GYRE_OVERLAY"
    fi
}

run_alas_foreground() {
    allow_prompt="${1:-yes}"
    resolve_alas_root "$allow_prompt" || return 1
    cleanup_temp
    ensure_alas_port_free || return 1
    start_updater || true
    prepare_overlay_env
    printf '%s\n' "$$" > "$PID_FILE" 2>/dev/null || true
    cd "$ALAS_ROOT" || return 1
    echo "[Alas-Gyre] Starting ALAS with Overlay. Root: $ALAS_ROOT"

    if [ -f "./run_alas.sh" ]; then
        if [ -x "./run_alas.sh" ]; then
            exec ./run_alas.sh
        else
            exec sh ./run_alas.sh
        fi
    elif command -v pixi >/dev/null 2>&1 && [ -f "./pixi.toml" ]; then
        exec pixi run python gui.py
    elif [ -x "./.pixi/envs/default/bin/python" ]; then
        exec ./.pixi/envs/default/bin/python gui.py
    elif [ -x "./.venv/bin/python" ]; then
        exec ./.venv/bin/python gui.py
    elif [ -x "./venv/bin/python" ]; then
        exec ./venv/bin/python gui.py
    elif [ -x "./toolkit/python" ]; then
        exec ./toolkit/python gui.py
    elif [ -x "./toolkit/python.exe" ]; then
        exec ./toolkit/python.exe gui.py
    else
        echo "[Alas-Gyre] ALAS Python environment not found; falling back to python3." >&2
        exec python3 gui.py
    fi
}

start_background() {
    cleanup_stale_pid
    if is_managed_running; then
        pid="$(get_pid)"
        echo "[Alas-Gyre] ALAS is already running under Gyre. pid=$pid"
        return 0
    fi
    resolve_alas_root yes || return 1
    cleanup_temp
    ensure_alas_port_free || return 1
    mkdir -p "$GYRE_RUNTIME" 2>/dev/null || true
    : >> "$LOG_FILE" 2>/dev/null || true
    echo "[Alas-Gyre] Starting ALAS in background..."
    nohup sh "$SCRIPT_PATH" __gyre_service_run >> "$LOG_FILE" 2>&1 &
    bg_pid=$!
    printf '%s\n' "$bg_pid" > "$PID_FILE"
    sleep 2
    if is_managed_running; then
        echo "[Alas-Gyre] Started. pid=$bg_pid"
        echo "[Alas-Gyre] Log: $LOG_FILE"
        return 0
    fi
    echo "[Alas-Gyre] Start failed or exited quickly. Check log: $LOG_FILE" >&2
    rm -f "$PID_FILE" 2>/dev/null || true
    if [ -f "$LOG_FILE" ]; then
        tail -n 40 "$LOG_FILE" 2>/dev/null || true
    fi
    return 1
}

stop_managed_alas() {
    if ! is_managed_running; then
        cleanup_stale_pid
        echo "[Alas-Gyre] No Gyre-managed ALAS is running."
        return 0
    fi
    pid="$(get_pid)"
    echo "[Alas-Gyre] Stopping Gyre-managed ALAS. pid=$pid"
    kill "$pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 10 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$PID_FILE" 2>/dev/null || true
            echo "[Alas-Gyre] Stopped."
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    echo "[Alas-Gyre] Process did not exit after TERM; sending KILL."
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
    rm -f "$PID_FILE" 2>/dev/null || true
    echo "[Alas-Gyre] Stopped."
}

restart_background() {
    stop_managed_alas
    start_background
}

