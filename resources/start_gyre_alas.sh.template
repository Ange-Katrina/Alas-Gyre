shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\''/g")"
}

write_systemd_service() {
    target="$1"
    mkdir -p "$(dirname -- "$target")"
    script_q="$(shell_quote "$SCRIPT_PATH")"
    cat > "$target" <<EOF
[Unit]
Description=Alas-Gyre Overlay ALAS launcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'exec "\$1" __gyre_service_run' sh $script_q
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
}

write_openrc_service() {
    target="$1"
    mkdir -p "$(dirname -- "$target")"
    cat > "$target" <<EOF
#!/sbin/openrc-run
description="Alas-Gyre Overlay ALAS launcher"
command="/bin/sh"
command_args="$SCRIPT_PATH __gyre_service_run"
command_background="yes"
pidfile="$PID_FILE"
output_log="$LOG_FILE"
error_log="$LOG_FILE"

depend() {
    need localmount
    after net
}
EOF
    chmod +x "$target" 2>/dev/null || true
}

generate_service_files() {
    mkdir -p "$SERVICE_DIR"
    write_systemd_service "$SERVICE_DIR/$SYSTEMD_SERVICE_NAME"
    write_openrc_service "$SERVICE_DIR/$OPENRC_SERVICE_NAME"
}

detect_service_manager() {
    if command -v systemctl >/dev/null 2>&1 && [ -d /etc/systemd/system ]; then
        echo systemd
    elif command -v rc-update >/dev/null 2>&1 || [ -x /sbin/openrc-run ]; then
        echo openrc
    else
        echo none
    fi
}

is_root() {
    [ "$(id -u 2>/dev/null || echo 1)" = "0" ]
}

install_autostart() {
    resolve_alas_root yes || return 1
    cleanup_temp
    generate_service_files
    manager="$(detect_service_manager)"
    echo "[Alas-Gyre] Service files generated in: $SERVICE_DIR"

    if ! is_root; then
        echo "[Alas-Gyre] Root permission is required to install autostart."
        if [ "$manager" = "systemd" ] || [ "$manager" = "none" ]; then
            echo "systemd manual install:"
            echo "  sudo cp $(shell_quote "$SERVICE_DIR/$SYSTEMD_SERVICE_NAME") /etc/systemd/system/$SYSTEMD_SERVICE_NAME"
            echo "  sudo systemctl daemon-reload"
            echo "  sudo systemctl enable $SYSTEMD_SERVICE_NAME"
        fi
        if [ "$manager" = "openrc" ] || [ "$manager" = "none" ]; then
            echo "OpenRC manual install:"
            echo "  sudo cp $(shell_quote "$SERVICE_DIR/$OPENRC_SERVICE_NAME") /etc/init.d/$OPENRC_SERVICE_NAME"
            echo "  sudo chmod +x /etc/init.d/$OPENRC_SERVICE_NAME"
            echo "  sudo rc-update add $OPENRC_SERVICE_NAME default"
        fi
        return 0
    fi

    case "$manager" in
        systemd)
            cp "$SERVICE_DIR/$SYSTEMD_SERVICE_NAME" "/etc/systemd/system/$SYSTEMD_SERVICE_NAME"
            systemctl daemon-reload
            systemctl enable "$SYSTEMD_SERVICE_NAME"
            echo "[Alas-Gyre] systemd autostart installed: $SYSTEMD_SERVICE_NAME"
            echo "[Alas-Gyre] Start now: systemctl start $SYSTEMD_SERVICE_NAME"
            ;;
        openrc)
            cp "$SERVICE_DIR/$OPENRC_SERVICE_NAME" "/etc/init.d/$OPENRC_SERVICE_NAME"
            chmod +x "/etc/init.d/$OPENRC_SERVICE_NAME"
            rc-update add "$OPENRC_SERVICE_NAME" default
            echo "[Alas-Gyre] OpenRC autostart installed: $OPENRC_SERVICE_NAME"
            echo "[Alas-Gyre] Start now: rc-service $OPENRC_SERVICE_NAME start"
            ;;
        *)
            echo "[Alas-Gyre] No supported service manager detected. Service files remain in $SERVICE_DIR" >&2
            return 1
            ;;
    esac
}

uninstall_autostart() {
    manager="$(detect_service_manager)"
    generate_service_files
    if ! is_root; then
        echo "[Alas-Gyre] Root permission is required to uninstall autostart."
        echo "systemd manual uninstall:"
        echo "  sudo systemctl disable $SYSTEMD_SERVICE_NAME"
        echo "  sudo rm -f /etc/systemd/system/$SYSTEMD_SERVICE_NAME"
        echo "  sudo systemctl daemon-reload"
        echo "OpenRC manual uninstall:"
        echo "  sudo rc-update del $OPENRC_SERVICE_NAME default"
        echo "  sudo rm -f /etc/init.d/$OPENRC_SERVICE_NAME"
        return 0
    fi

    if [ "$manager" = "systemd" ] || [ -f "/etc/systemd/system/$SYSTEMD_SERVICE_NAME" ]; then
        systemctl disable "$SYSTEMD_SERVICE_NAME" 2>/dev/null || true
        rm -f "/etc/systemd/system/$SYSTEMD_SERVICE_NAME"
        systemctl daemon-reload 2>/dev/null || true
        echo "[Alas-Gyre] systemd autostart removed."
    fi
    if [ "$manager" = "openrc" ] || [ -f "/etc/init.d/$OPENRC_SERVICE_NAME" ]; then
        rc-update del "$OPENRC_SERVICE_NAME" default 2>/dev/null || true
        rm -f "/etc/init.d/$OPENRC_SERVICE_NAME"
        echo "[Alas-Gyre] OpenRC autostart removed."
    fi
}

