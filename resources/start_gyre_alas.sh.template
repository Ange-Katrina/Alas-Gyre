        shift || true
        run_alas_foreground no
        ;;
    *)
        # Keep the runtime updater available by default.  This lets the desktop
        # client update gyre_runtime later without requiring an SSH/menu visit.
        start_updater >/dev/null 2>&1 || true
        show_menu
        ;;
esac
