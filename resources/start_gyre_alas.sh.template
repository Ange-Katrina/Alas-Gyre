#!/bin/sh
set -eu

GYRE_RUNTIME="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
SCRIPT_PATH="$GYRE_RUNTIME/start_gyre_alas.sh"
CONF_FILE="$GYRE_RUNTIME/.gyre_runtime.conf"
LEGACY_ROOT_CACHE="$GYRE_RUNTIME/.gyre_alas_root"
PID_FILE="$GYRE_RUNTIME/.gyre_alas.pid"
LOG_FILE="$GYRE_RUNTIME/.gyre_alas.log"
UPDATER_SCRIPT="$GYRE_RUNTIME/gyre_runtime_updater.py"
UPDATER_PID_FILE="$GYRE_RUNTIME/.gyre_updater.pid"
UPDATER_LOG_FILE="$GYRE_RUNTIME/.gyre_updater.log"
SERVICE_DIR="$GYRE_RUNTIME/service"
SYSTEMD_SERVICE_NAME="alas-gyre-overlay.service"
OPENRC_SERVICE_NAME="alas-gyre-overlay"
ALAS_GYRE_OVERLAY="$GYRE_RUNTIME/overlay"
ALAS_GYRE_API_TOKEN=__API_TOKEN__
DEFAULT_GYRE_UPDATE_HOST="0.0.0.0"
DEFAULT_GYRE_UPDATE_PORT="22268"
GYRE_UPDATE_HOST="${GYRE_UPDATE_HOST:-$DEFAULT_GYRE_UPDATE_HOST}"
GYRE_UPDATE_PORT="${GYRE_UPDATE_PORT:-$DEFAULT_GYRE_UPDATE_PORT}"
ALAS_WEBUI_PORT="${ALAS_WEBUI_PORT:-}"
GYRE_LANG="${GYRE_LANG:-}"
MENU_DISCOVERY_DONE=0
MENU_DISCOVERY_HINT=""
export ALAS_GYRE_OVERLAY ALAS_GYRE_API_TOKEN

CANDIDATE_FILE="${TMPDIR:-/tmp}/gyre_alas_candidates.$$"
FOUND_FILE="${TMPDIR:-/tmp}/gyre_alas_found.$$"
trap 'rm -f "$CANDIDATE_FILE" "$FOUND_FILE"' EXIT INT TERM

C_RESET=""
C_BOLD=""
C_DIM=""
C_RED=""
C_GREEN=""
C_YELLOW=""
C_BLUE=""
C_MAGENTA=""
C_CYAN=""
C_GRAY=""

setup_colors() {
    case "${GYRE_COLOR:-auto}" in
        never|no|0)
            return 0
            ;;
        always|yes|1)
            use_color=1
            ;;
        *)
            if [ -t 1 ] && [ "${NO_COLOR:-}" = "" ] && [ "${TERM:-}" != "dumb" ]; then
                use_color=1
            else
                use_color=0
            fi
            ;;
    esac
    [ "$use_color" = "1" ] || return 0
    C_RESET="$(printf '\033[0m')"
    C_BOLD="$(printf '\033[1m')"
    C_DIM="$(printf '\033[2m')"
    C_RED="$(printf '\033[31m')"
    C_GREEN="$(printf '\033[32m')"
    C_YELLOW="$(printf '\033[33m')"
    C_BLUE="$(printf '\033[34m')"
    C_MAGENTA="$(printf '\033[35m')"
    C_CYAN="$(printf '\033[36m')"
    C_GRAY="$(printf '\033[90m')"
}

setup_colors

print_rule() {
    printf '%s--------------------------------------------------%s\n' "${C_GRAY}" "${C_RESET}"
}

print_title() {
    printf '%s%s%s\n' "${C_BOLD}${C_CYAN}" "$1" "${C_RESET}"
}

panel_top() {
    echo
    print_title "$1"
    print_rule
}

panel_bottom() {
    print_rule
}

panel_line() {
    label="$1"
    value="$2"
    printf '  %s%s%s : %s\n' "${C_DIM}" "$label" "${C_RESET}" "$value"
}

menu_group() {
    printf '\n%s%s%s\n' "${C_BOLD}" "$1" "${C_RESET}"
}

menu_item() {
    menu_no="$1"
    menu_text="$2"
    menu_kind="${3:-normal}"
    case "$menu_kind" in
        good) menu_color="${C_GREEN}" ;;
        danger) menu_color="${C_RED}" ;;
        warn) menu_color="${C_YELLOW}" ;;
        info) menu_color="${C_CYAN}" ;;
        muted) menu_color="${C_GRAY}" ;;
        *) menu_color="" ;;
    esac
    printf '  %s%2s)%s %s%s%s\n' "${C_GRAY}" "$menu_no" "${C_RESET}" "$menu_color" "$menu_text" "${C_RESET}"
}

prompt_text() {
    printf '\n%s>%s %s' "${C_YELLOW}" "${C_RESET}" "$1"
}

success_msg() {
    printf '%s[OK]%s %s\n' "${C_GREEN}" "${C_RESET}" "$*"
}

warn_msg() {
    printf '%s[WARN]%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*"
}

error_msg() {
    printf '%s[ERR]%s %s\n' "${C_RED}" "${C_RESET}" "$*"
}


cleanup_temp() {
    rm -f "$CANDIDATE_FILE" "$FOUND_FILE" 2>/dev/null || true
}

is_alas_root() {
    [ -n "${1:-}" ] || return 1
    [ -f "$1/gui.py" ] && [ -f "$1/module/webui/app.py" ]
}

load_config() {
    env_lang="${GYRE_LANG:-}"
    env_update_host="${GYRE_UPDATE_HOST:-}"
    env_update_port="${GYRE_UPDATE_PORT:-}"
    env_alas_webui_port="${ALAS_WEBUI_PORT:-}"
    ALAS_ROOT=""
    GYRE_LANG=""
    GYRE_UPDATE_HOST="$DEFAULT_GYRE_UPDATE_HOST"
    GYRE_UPDATE_PORT="$DEFAULT_GYRE_UPDATE_PORT"
    ALAS_WEBUI_PORT=""
    if [ -f "$CONF_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                ALAS_ROOT=*) ALAS_ROOT=${line#ALAS_ROOT=} ;;
                GYRE_LANG=*) GYRE_LANG=${line#GYRE_LANG=} ;;
                GYRE_UPDATE_HOST=*) GYRE_UPDATE_HOST=${line#GYRE_UPDATE_HOST=} ;;
                GYRE_UPDATE_PORT=*) GYRE_UPDATE_PORT=${line#GYRE_UPDATE_PORT=} ;;
                ALAS_WEBUI_PORT=*) ALAS_WEBUI_PORT=${line#ALAS_WEBUI_PORT=} ;;
            esac
        done < "$CONF_FILE"
    fi
    if [ -z "$ALAS_ROOT" ] && [ -f "$LEGACY_ROOT_CACHE" ]; then
        IFS= read -r ALAS_ROOT < "$LEGACY_ROOT_CACHE" || ALAS_ROOT=""
    fi
    case "$env_lang" in
        zh|en) GYRE_LANG="$env_lang" ;;
    esac
    [ -n "$env_update_host" ] && GYRE_UPDATE_HOST="$env_update_host"
    [ -n "$env_update_port" ] && GYRE_UPDATE_PORT="$env_update_port"
    [ -n "$env_alas_webui_port" ] && ALAS_WEBUI_PORT="$env_alas_webui_port"
    case "$GYRE_LANG" in
        zh|en) ;;
        *) GYRE_LANG="$(default_lang)" ;;
    esac
    case "$GYRE_UPDATE_PORT" in
        ''|*[!0-9]*) GYRE_UPDATE_PORT="$DEFAULT_GYRE_UPDATE_PORT" ;;
    esac
    [ -n "$GYRE_UPDATE_HOST" ] || GYRE_UPDATE_HOST="$DEFAULT_GYRE_UPDATE_HOST"
}
save_config() {
    mkdir -p "$GYRE_RUNTIME" 2>/dev/null || true
    case "${GYRE_LANG:-}" in
        zh|en) ;;
        *) GYRE_LANG="$(default_lang)" ;;
    esac
    case "$GYRE_UPDATE_PORT" in
        ''|*[!0-9]*) GYRE_UPDATE_PORT="$DEFAULT_GYRE_UPDATE_PORT" ;;
    esac
    [ -n "$GYRE_UPDATE_HOST" ] || GYRE_UPDATE_HOST="$DEFAULT_GYRE_UPDATE_HOST"
    printf 'ALAS_ROOT=%s
GYRE_LANG=%s
GYRE_UPDATE_HOST=%s
GYRE_UPDATE_PORT=%s
ALAS_WEBUI_PORT=%s
' "${ALAS_ROOT:-}" "$GYRE_LANG" "$GYRE_UPDATE_HOST" "$GYRE_UPDATE_PORT" "${ALAS_WEBUI_PORT:-}" > "$CONF_FILE"
}

save_alas_root() {
    save_config
    printf '%s\n' "$ALAS_ROOT" > "$LEGACY_ROOT_CACHE" 2>/dev/null || true
}


locale_is_utf8() {
    [ "${GYRE_FORCE_ZH:-}" = "1" ] && return 0
    locale_value="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    case "$locale_value" in
        *UTF-8*|*utf-8*|*UTF8*|*utf8*) return 0 ;;
    esac
    if command -v locale >/dev/null 2>&1; then
        charmap="$(locale charmap 2>/dev/null || true)"
        case "$charmap" in
            *UTF-8*|*utf-8*|*UTF8*|*utf8*) return 0 ;;
        esac
    fi
    return 1
}

default_lang() {
    if [ "${GYRE_FORCE_ZH:-}" = "1" ]; then
        printf 'zh'
        return 0
    fi
    lang_probe="${LC_ALL:-} ${LC_MESSAGES:-} ${LANGUAGE:-} ${LANG:-} ${LC_CTYPE:-}"
    case "$lang_probe" in
        zh*|*' zh'*|*zh_CN*|*zh_SG*|*zh_TW*|*zh_HK*|*zh_MO*|*zh-Hans*|*zh-Hant*)
            printf 'zh'
            ;;
        *)
            printf 'en'
            ;;
    esac
}

is_zh() {
    [ "${GYRE_LANG:-}" = "zh" ]
}

not_configured_text() {
    if is_zh; then
        printf '未配置'
    else
        printf 'not configured'
    fi
}

switch_language() {
    load_config
    if [ "$GYRE_LANG" = "zh" ]; then
        GYRE_LANG="en"
        save_config
        echo "[Alas-Gyre] Language switched to English."
        return 0
    fi
    GYRE_LANG="zh"
    save_config
    echo "[Alas-Gyre] 已切换为中文。"
}

add_candidate() {
    candidate="${1:-}"
    [ -n "$candidate" ] || return 0
    [ -d "$candidate" ] || return 0
    candidate="$(CDPATH= cd -- "$candidate" 2>/dev/null && pwd)" || return 0
    is_alas_root "$candidate" || return 0
    grep -Fxq "$candidate" "$CANDIDATE_FILE" 2>/dev/null || printf '%s\n' "$candidate" >> "$CANDIDATE_FILE"
}

discover_alas_roots() {
    : > "$CANDIDATE_FILE"
    : > "$FOUND_FILE"
    parent="$(dirname -- "$GYRE_RUNTIME")"
    home_dir="${HOME:-}"

    add_candidate "$GYRE_RUNTIME"
    add_candidate "$parent"
    add_candidate "$parent/AzurLaneAutoScript"
    add_candidate "$parent/AlasApp/AzurLaneAutoScript"
    add_candidate "$parent/AlasApp_0.4.10_fullcn/AzurLaneAutoScript"

    if [ -n "$home_dir" ]; then
        add_candidate "$home_dir/AzurLaneAutoScript"
        add_candidate "$home_dir/AlasApp/AzurLaneAutoScript"
        add_candidate "$home_dir/AlasApp_0.4.10_fullcn/AzurLaneAutoScript"
    fi

    for base in "$parent" "$home_dir" /root /opt /srv /app; do
        [ -n "$base" ] || continue
        [ -d "$base" ] || continue
        add_candidate "$base/AzurLaneAutoScript"
        add_candidate "$base/AlasApp/AzurLaneAutoScript"
        add_candidate "$base/AlasApp_0.4.10_fullcn/AzurLaneAutoScript"
        if command -v find >/dev/null 2>&1; then
            find "$base" -maxdepth 4 -type f -name gui.py 2>/dev/null >> "$FOUND_FILE" || true
        fi
    done

    while IFS= read -r gui_file || [ -n "$gui_file" ]; do
        [ -n "$gui_file" ] || continue
        add_candidate "$(dirname -- "$gui_file")"
    done < "$FOUND_FILE"
}

auto_discover_menu() {
    [ "${MENU_DISCOVERY_DONE:-0}" = "0" ] || return 0
    MENU_DISCOVERY_DONE=1
    MENU_DISCOVERY_HINT=""
    [ -z "${ALAS_ROOT:-}" ] || return 0

    discover_alas_roots
    count="$(wc -l < "$CANDIDATE_FILE" | tr -d ' ')"
    case "$count" in
        1)
            IFS= read -r ALAS_ROOT < "$CANDIDATE_FILE" || ALAS_ROOT=""
            if [ -n "$ALAS_ROOT" ] && is_alas_root "$ALAS_ROOT"; then
                save_alas_root
                if is_zh; then
                    MENU_DISCOVERY_HINT="${C_GREEN}已自动找到并保存 ALAS 目录${C_RESET}"
                else
                    MENU_DISCOVERY_HINT="${C_GREEN}Found and saved ALAS root automatically${C_RESET}"
                fi
            fi
            ;;
        0)
            if is_zh; then
                MENU_DISCOVERY_HINT="${C_YELLOW}未自动找到 ALAS；请选择 6 手动输入路径${C_RESET}"
            else
                MENU_DISCOVERY_HINT="${C_YELLOW}ALAS was not detected; choose 6 to enter the path manually${C_RESET}"
            fi
            ;;
        *)
            if is_zh; then
                MENU_DISCOVERY_HINT="${C_YELLOW}检测到 $count 个 ALAS 候选目录；请选择 6 指定${C_RESET}"
            else
                MENU_DISCOVERY_HINT="${C_YELLOW}Detected $count ALAS candidates; choose 6 to select one${C_RESET}"
            fi
            ;;
    esac
}

print_candidates() {
    index=1
    while IFS= read -r candidate || [ -n "$candidate" ]; do
        [ -n "$candidate" ] || continue
        printf '  %s) %s\n' "$index" "$candidate"
        index=$((index + 1))
    done < "$CANDIDATE_FILE"
}

choose_alas_root() {
    load_config
    echo
    echo "========================================"
    if is_zh; then
        echo " Alas-Gyre Overlay 初始化"
        echo "========================================"
        echo "ALAS 根目录必须包含：gui.py 和 module/webui/app.py"
        echo
        if [ -s "$CANDIDATE_FILE" ]; then
            echo "检测到候选目录："
            print_candidates
            echo
        else
            echo "未自动检测到 ALAS 根目录。"
            echo
        fi
    else
        echo " Alas-Gyre Overlay Init"
        echo "========================================"
        echo "ALAS root must contain: gui.py and module/webui/app.py"
        echo
        if [ -s "$CANDIDATE_FILE" ]; then
            echo "Detected candidates:"
            print_candidates
            echo
        else
            echo "No ALAS root was detected automatically."
            echo
        fi
    fi
    if [ ! -t 0 ]; then
        if is_zh; then
            echo "非交互 shell。请设置 ALAS_ROOT=/path/to/AzurLaneAutoScript，或写入 $CONF_FILE。" >&2
        else
            echo "Non-interactive shell. Set ALAS_ROOT=/path/to/AzurLaneAutoScript or write ALAS_ROOT to $CONF_FILE." >&2
        fi
        return 1
    fi
    while :; do
        if is_zh; then
            printf '请选择序号或输入 ALAS 根目录路径 [q 退出]: '
        else
            printf 'Select number or enter ALAS root path [q to quit]: '
        fi
        IFS= read -r answer || return 1
        answer="$(printf '%s' "$answer" | tr -d '\r')"
        case "$answer" in
            q|Q|quit|exit) return 1 ;;
            '') continue ;;
            *[!0-9]*) selected="$answer" ;;
            *)
                selected="$(sed -n "${answer}p" "$CANDIDATE_FILE" 2>/dev/null || true)"
                [ -n "$selected" ] || selected="$answer"
                ;;
        esac
        if is_alas_root "$selected"; then
            ALAS_ROOT="$(CDPATH= cd -- "$selected" && pwd)"
            save_alas_root
            if is_zh; then
                echo "[Alas-Gyre] 已保存 ALAS 根目录：$ALAS_ROOT"
            else
                echo "[Alas-Gyre] Saved ALAS root: $ALAS_ROOT"
            fi
            return 0
        fi
        if is_zh; then
            echo "无效的 ALAS 根目录：$selected"
        else
            echo "Invalid ALAS root: $selected"
        fi
    done
}
resolve_alas_root() {
    allow_prompt="${1:-yes}"
    env_root="${ALAS_ROOT:-}"
    load_config

    if [ -n "$env_root" ]; then
        if is_alas_root "$env_root"; then
            ALAS_ROOT="$(CDPATH= cd -- "$env_root" && pwd)"
            save_alas_root
            echo "[Alas-Gyre] ALAS root: $ALAS_ROOT"
            return 0
        fi
        echo "[Alas-Gyre] Ignoring invalid ALAS_ROOT: $env_root" >&2
    fi

    if [ -n "$ALAS_ROOT" ] && is_alas_root "$ALAS_ROOT"; then
        ALAS_ROOT="$(CDPATH= cd -- "$ALAS_ROOT" && pwd)"
        echo "[Alas-Gyre] ALAS root: $ALAS_ROOT"
        return 0
    fi

    discover_alas_roots
    count="$(wc -l < "$CANDIDATE_FILE" | tr -d ' ')"
    if [ "$count" = "1" ]; then
        IFS= read -r ALAS_ROOT < "$CANDIDATE_FILE"
        save_alas_root
        echo "[Alas-Gyre] Found ALAS root: $ALAS_ROOT"
        return 0
    fi

    if [ "$allow_prompt" = "yes" ]; then
        choose_alas_root
        return $?
    fi

    if [ "$count" = "0" ]; then
        echo "[Alas-Gyre] ALAS root not configured and not detected." >&2
    else
        echo "[Alas-Gyre] Multiple ALAS roots detected. Run this script interactively and choose one." >&2
    fi
    return 1
}

get_pid() {
    pid=""
    if [ -f "$PID_FILE" ]; then
        IFS= read -r pid < "$PID_FILE" || pid=""
    fi
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$pid"
    return 0
}

is_managed_running() {
    pid="$(get_pid 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

cleanup_stale_pid() {
    if [ -f "$PID_FILE" ] && ! is_managed_running; then
        rm -f "$PID_FILE" 2>/dev/null || true
    fi
}

status_line() {
    if is_managed_running; then
        pid="$(get_pid)"
        if is_zh; then
            printf '%s[运行中 pid=%s]%s' "${C_GREEN}" "$pid" "${C_RESET}"
        else
            printf '%s[RUNNING pid=%s]%s' "${C_GREEN}" "$pid" "${C_RESET}"
        fi
    else
        if is_zh; then
            printf '%s[已停止]%s' "${C_RED}" "${C_RESET}"
        else
            printf '%s[STOPPED]%s' "${C_RED}" "${C_RESET}"
        fi
    fi
}

get_updater_pid() {
    pid=""
    if [ -f "$UPDATER_PID_FILE" ]; then
        IFS= read -r pid < "$UPDATER_PID_FILE" || pid=""
    fi
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s
' "$pid"
    return 0
}

is_updater_running() {
    pid="$(get_updater_pid 2>/dev/null || true)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

cleanup_stale_updater_pid() {
    if [ -f "$UPDATER_PID_FILE" ] && ! is_updater_running; then
        rm -f "$UPDATER_PID_FILE" 2>/dev/null || true
    fi
}

updater_token_matches() {
    py="$(find_updater_python 2>/dev/null || true)"
    [ -n "$py" ] || return 1
    GYRE_CHECK_PORT="$GYRE_UPDATE_PORT" ALAS_GYRE_API_TOKEN="$ALAS_GYRE_API_TOKEN" "$py" -c '
import os
import sys
try:
    from urllib import request, error
    port = os.environ.get("GYRE_CHECK_PORT", "22268")
    token = os.environ.get("ALAS_GYRE_API_TOKEN", "")
    req = request.Request(
        "http://127.0.0.1:%s/runtime/info" % port,
        headers={"X-Alas-Gyre-Token": token},
    )
    try:
        with request.urlopen(req, timeout=2) as resp:
            sys.exit(0 if resp.getcode() == 200 else 1)
    except error.HTTPError as exc:
        sys.exit(2 if exc.code == 401 else 1)
except Exception:
    sys.exit(1)
' >/dev/null 2>&1
}

is_runtime_updater_pid() {
    pid="$1"
    cmd="$(pid_cmdline "$pid")"
    case "$cmd" in
        *gyre_runtime_updater.py*)
            return 0
            ;;
    esac
    return 1
}

adopt_or_report_updater_port() {
    pids="$(port_listener_pids "$GYRE_UPDATE_PORT" 2>/dev/null || true)"
    [ -n "$pids" ] || return 1
    for pid in $pids; do
        [ -n "$pid" ] || continue
        if is_runtime_updater_pid "$pid"; then
            printf '%s\n' "$pid" > "$UPDATER_PID_FILE" 2>/dev/null || true
            if updater_token_matches; then
                return 0
            fi
            warn_msg "Existing runtime updater uses an old token; restarting it."
            stop_updater
            return 1
        fi
    done
    warn_msg "Runtime update port $GYRE_UPDATE_PORT is already in use by pid(s): $pids"
    warn_msg "Refusing to start another updater. Change GYRE_UPDATE_PORT in .gyre_runtime.conf if needed."
    return 2
}

updater_status_line() {
    if is_updater_running; then
        pid="$(get_updater_pid)"
        if is_zh; then
            printf '%s[运行中 pid=%s] %s:%s%s' "${C_GREEN}" "$pid" "$GYRE_UPDATE_HOST" "$GYRE_UPDATE_PORT" "${C_RESET}"
        else
            printf '%s[RUNNING pid=%s] %s:%s%s' "${C_GREEN}" "$pid" "$GYRE_UPDATE_HOST" "$GYRE_UPDATE_PORT" "${C_RESET}"
        fi
    else
        if is_zh; then
            printf '%s[已停止] %s:%s%s' "${C_RED}" "$GYRE_UPDATE_HOST" "$GYRE_UPDATE_PORT" "${C_RESET}"
        else
            printf '%s[STOPPED] %s:%s%s' "${C_RED}" "$GYRE_UPDATE_HOST" "$GYRE_UPDATE_PORT" "${C_RESET}"
        fi
    fi
}

find_updater_python() {
    if [ -n "${ALAS_ROOT:-}" ]; then
        for py in             "$ALAS_ROOT/.pixi/envs/default/bin/python"             "$ALAS_ROOT/.venv/bin/python"             "$ALAS_ROOT/venv/bin/python"             "$ALAS_ROOT/toolkit/python"             "$ALAS_ROOT/toolkit/python.exe"
        do
            [ -x "$py" ] && { printf '%s
' "$py"; return 0; }
        done
    fi
    if command -v python3 >/dev/null 2>&1; then
        command -v python3
        return 0
    fi
    if command -v python >/dev/null 2>&1; then
        command -v python
        return 0
    fi
    return 1
}

start_updater() {
    load_config
    cleanup_stale_updater_pid
    if is_updater_running; then
        if updater_token_matches; then
            return 0
        fi
        warn_msg "Runtime updater token does not match current launcher; restarting it."
        stop_updater
    fi
    if adopt_or_report_updater_port; then
        return 0
    else
        adopt_status=$?
        [ "$adopt_status" = "2" ] && return 1
    fi
    if [ ! -f "$UPDATER_SCRIPT" ]; then
        warn_msg "gyre_runtime_updater.py not found; runtime update service disabled."
        return 1
    fi
    py="$(find_updater_python 2>/dev/null || true)"
    if [ -z "$py" ]; then
        warn_msg "Python not found; runtime update service disabled."
        return 1
    fi
    mkdir -p "$GYRE_RUNTIME" 2>/dev/null || true
    : >> "$UPDATER_LOG_FILE" 2>/dev/null || true
    export ALAS_GYRE_API_TOKEN GYRE_UPDATE_HOST GYRE_UPDATE_PORT
    nohup "$py" "$UPDATER_SCRIPT" --runtime "$GYRE_RUNTIME" --host "$GYRE_UPDATE_HOST" --port "$GYRE_UPDATE_PORT" >> "$UPDATER_LOG_FILE" 2>&1 &
    updater_pid=$!
    printf '%s
' "$updater_pid" > "$UPDATER_PID_FILE"
    sleep 1
    if is_updater_running; then
        return 0
    fi
    rm -f "$UPDATER_PID_FILE" 2>/dev/null || true
    warn_msg "Runtime update service failed to start. Log: $UPDATER_LOG_FILE"
    return 1
}

stop_updater() {
    if ! is_updater_running; then
        cleanup_stale_updater_pid
        return 0
    fi
    pid="$(get_updater_pid)"
    kill "$pid" 2>/dev/null || true
    i=0
    while [ "$i" -lt 5 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$UPDATER_PID_FILE" 2>/dev/null || true
            return 0
        fi
        i=$((i + 1))
        sleep 1
    done
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
    rm -f "$UPDATER_PID_FILE" 2>/dev/null || true
}

restart_updater() {
    stop_updater
    start_updater
}

show_updater_status() {
